.DS_Store
docs/anonymized/

# Deploy CLI credentials — written by the `deploy` container (CLOUDSDK_CONFIG /
# XDG_CONFIG_HOME) so gcloud / firebase auth survives `docker compose down -v`.
# Refresh tokens: never commit.
.deploy-auth/
.claude/
temp/

# Local secrets that docker-compose.yml reads, such as Badhan Agent's OPENAI_API_KEY. The
# template, .env.example, is committed. Anchored to the root: the two test projects commit
# their own .env files, which hold no secrets.
/.env
