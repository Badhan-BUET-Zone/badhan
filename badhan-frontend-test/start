#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Defaults
SPEC_PATH=""

# Parse flags
HEADED=false
VIDEO=false
for arg in "$@"; do
  case "$arg" in
    --headed)
      HEADED=true
      ;;
    --video)
      VIDEO=true
      ;;
    --*)
      # ignore other flags
      ;;
    *)
      # first non-flag argument is treated as spec path
      if [[ -z "$SPEC_PATH" ]]; then
        SPEC_PATH="$arg"
      fi
      ;;
  esac
done

# Normalize spec path to project-relative if inside project (only if provided)
REL_SPEC=""
if [[ -n "$SPEC_PATH" ]]; then
  if [[ "$SPEC_PATH" = $PROJECT_DIR/* ]]; then
    REL_SPEC="${SPEC_PATH#"$PROJECT_DIR"/}"
  else
    REL_SPEC="$SPEC_PATH"
  fi
fi

cd "$PROJECT_DIR"

CMD=(npx cypress run)
if [[ -n "$REL_SPEC" ]]; then
  CMD+=(--spec "$REL_SPEC")
fi

if $HEADED; then
  CMD+=(--headed --browser chrome --env openDevTools=true)
fi

if $VIDEO; then
  CMD+=(--config video=true)
fi

exec "${CMD[@]}"


