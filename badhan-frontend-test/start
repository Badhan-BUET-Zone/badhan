#!/usr/bin/env node

const cypress = require('cypress');
const path = require('path');
const fs = require('fs');

// Configuration
const CONFIG = {
  projectRoot: __dirname,
  cypressConfig: path.join(__dirname, 'cypress.config.ts')
};

/**
 * Ensures log directories exist and clears old logs
 */
function setupLogDirectories() {
  const logsRoot = path.join(CONFIG.projectRoot, 'logs');
  const successDir = path.join(logsRoot, 'success');
  const errorDir = path.join(logsRoot, 'error');
  
  console.log(`[start] Setting up log directories: ${logsRoot}`);
  
  // Create directories if they don't exist
  if (!fs.existsSync(logsRoot)) {
    fs.mkdirSync(logsRoot, { recursive: true });
  }
  if (!fs.existsSync(successDir)) {
    fs.mkdirSync(successDir, { recursive: true });
  }
  if (!fs.existsSync(errorDir)) {
    fs.mkdirSync(errorDir, { recursive: true });
  }

  // Clear old log files
  try {
    const successFiles = fs.readdirSync(successDir);
    successFiles.forEach(file => {
      if (file.endsWith('.txt')) {
        fs.unlinkSync(path.join(successDir, file));
      }
    });
  } catch (err) {
    // Directory might be empty, ignore error
  }

  try {
    const errorFiles = fs.readdirSync(errorDir);
    errorFiles.forEach(file => {
      if (file.endsWith('.txt')) {
        fs.unlinkSync(path.join(errorDir, file));
      }
    });
  } catch (err) {
    // Directory might be empty, ignore error
  }
}

/**
 * Parse command line arguments for Cypress
 * @param {Array} args - Raw command line arguments
 * @returns {Object} - Cypress configuration object
 */
function parseCypressArgs(args) {
  const config = {
    configFile: CONFIG.cypressConfig,
    project: CONFIG.projectRoot
  };
  
  let specPath = '';
  let headed = false;
  let video = false;
  
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    
    switch (arg) {
      case '--headed':
        headed = true;
        break;
      case '--video':
        video = true;
        break;
      case '--spec':
        if (i + 1 < args.length) {
          specPath = args[i + 1];
          i++; // Skip next argument as it's the spec path
        }
        break;
      default:
        // First non-flag argument is treated as spec path
        if (!arg.startsWith('--') && !specPath) {
          specPath = arg;
        }
        break;
    }
  }
  
  // Normalize spec path to project-relative if inside project
  if (specPath) {
    if (specPath.startsWith(CONFIG.projectRoot)) {
      specPath = path.relative(CONFIG.projectRoot, specPath);
    }
    config.spec = specPath;
  }
  
  if (headed) {
    config.headed = true;
    config.browser = 'chrome';
    config.env = { ...config.env, openDevTools: true };
  }
  
  if (video) {
    // Cypress.run expects video under the nested config object
    config.config = { ...(config.config || {}), video: true };
  }
  
  return config;
}

/**
 * Runs Cypress tests directly using Cypress API
 * @param {Array} args - Command line arguments to pass to Cypress
 * @returns {Promise<boolean>} - Returns true if all tests pass, false otherwise
 */
async function runCypressTests(args = []) {
  console.log('[start] Starting Cypress test execution...');
  
  const cypressConfig = parseCypressArgs(args);
  
  console.log('[start] Cypress configuration:', cypressConfig);
  
  if (cypressConfig.spec) {
    console.log(`[start] Running specific test: ${cypressConfig.spec}`);
  } else {
    console.log('[start] Running all tests');
  }
  
  try {
    // Run Cypress directly
    const result = await cypress.run(cypressConfig);

    const status = result && typeof result.status !== 'undefined' ? result.status : 'unknown';
    const failures = Number((result && result.failures) ?? 0);
    const totalFailed = Number((result && result.totalFailed) ?? 0);
    const totalPassed = Number((result && result.totalPassed) ?? 0);
    const totalTests = Number((result && result.totalTests) ?? 0);

    console.log('[start] Cypress result:', {
      status,
      failures,
      totalFailed,
      totalPassed,
      totalTests
    });

    // Treat undefined status/failures as zero and rely on totalFailed
    const allTestsPassed = failures === 0 && totalFailed === 0 && (totalTests > 0 || totalPassed > 0);

    if (allTestsPassed) {
      console.log('[start] All tests completed successfully');
      return true;
    } else {
      console.error('[start] Tests failed');
      return false;
    }
  } catch (error) {
    console.error('[start] Cypress execution failed:', error.message);
    return false;
  }
}

/**
 * Validates Cypress configuration
 */
function validateCypressConfig() {
  if (!fs.existsSync(CONFIG.cypressConfig)) {
    throw new Error(`Cypress config file not found: ${CONFIG.cypressConfig}`);
  }

  try {
    // Just check if the file exists and is readable
    fs.accessSync(CONFIG.cypressConfig, fs.constants.R_OK);
    console.log('[start] Cypress configuration validated');
  } catch (err) {
    throw new Error(`Invalid Cypress configuration: ${err.message}`);
  }
}

/**
 * Main execution function that can be called programmatically
 * @param {Array} args - Optional command line arguments
 * @returns {Promise<boolean>} - Returns true if all tests pass, false otherwise
 */
async function runTestSuite(args = []) {
  try {
    console.log('[start] Badhan Frontend Test Runner');
    console.log('[start] ===========================');

    // Validate Cypress configuration
    validateCypressConfig();
    
    // Setup log directories
    setupLogDirectories();
    
    // Run tests
    const success = await runCypressTests(args);
    
    console.log(`[start] Test execution completed with success: ${success}`);
    
    return success;
    
  } catch (error) {
    console.error('[start] Error:', error.message);
    return false;
  }
}

/**
 * Main execution function for standalone execution
 */
async function main() {
  // Parse command line arguments
  const args = process.argv.slice(2);
  
  const success = await runTestSuite(args);
  process.exit(success ? 0 : 1);
}

// Export functions for potential use as module
module.exports = {
  runTestSuite,
  runCypressTests,
  setupLogDirectories,
  validateCypressConfig,
  CONFIG
};

// Run main function if this file is executed directly
if (require.main === module) {
  main();
}