#!/usr/bin/env bash
# Wrapper to run Cypress tests the way *I* want
# ------------------------------------------------
#  • bash start                       → all tests, headless
#  • bash start path/to/spec.js       → single test, headless
#  • bash start --headed              → all tests, headed
#  • bash start path/to/spec.js --headed
#    or bash start --headed path/to/spec.js  → single test, headed
# ------------------------------------------------

# Default pattern: run everything
SPEC="cypress/integration/**/*"
HEADED=""

# Parse arguments
for ARG in "$@"; do
  case "$ARG" in
    --headed) HEADED="--headed" ;;              # UI mode
    -h|--help)
      echo "Usage: bash start [specPattern] [--headed]"
      exit 0
      ;;
    *) SPEC="$ARG" ;;                           # Treat anything else as spec pattern
  esac
done

# Run Cypress via the locally‑installed binary
npx cypress run --spec "$SPEC" $HEADED
