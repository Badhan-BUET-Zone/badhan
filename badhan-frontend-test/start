#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

SPEC_PATH="${1:-}"
if [[ -z "${SPEC_PATH}" ]]; then
  echo "Usage: bash start <spec-path> [--headed] [--video]"
  exit 1
fi

# Parse flags
HEADED=false
VIDEO=false
for arg in "${@:2}"; do
  case "$arg" in
    --headed)
      HEADED=true
      ;;
    --video)
      VIDEO=true
      ;;
    *)
      ;;
  esac
done

# Normalize spec path to project-relative if inside project
if [[ "$SPEC_PATH" = $PROJECT_DIR/* ]]; then
  REL_SPEC="${SPEC_PATH#"$PROJECT_DIR"/}"
else
  REL_SPEC="$SPEC_PATH"
fi

cd "$PROJECT_DIR"

CMD=(npx cypress run --spec "$REL_SPEC")

if $HEADED; then
  CMD+=(--headed --browser chrome --env openDevTools=true)
fi

if $VIDEO; then
  CMD+=(--config video=true)
fi

exec "${CMD[@]}"


