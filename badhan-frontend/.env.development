# NODE_ENV is the webpack build flavour; VUE_APP_ENVIRONMENT is which deployment
# this is. They are separate knobs — see .env.local, which builds in development
# flavour while calling itself the `local` environment.
#
# This file deliberately builds the development environment in PRODUCTION flavour.
# That is what makes the development site a rehearsal rather than a different app:
# @vue/cli-plugin-pwa only generates dist/service-worker.js when NODE_ENV is
# production (node_modules/@vue/cli-plugin-pwa/index.js:36), so with a development
# flavour the site registers a worker that 404s — no precache, no offline shell, no
# update-and-reload path, which is the whole point of having a test environment for
# them. Minification, source maps and Workbox config now match production exactly;
# the unminified, devtools-enabled build lives in the `local` environment, where
# debugging belongs.
VUE_APP_BADHAN_API_BASE_URL=https://badhan-buet-test.uc.r.appspot.com
VUE_APP_FRONTEND_BASE=https://badhan-buet-test-46eca.web.app
NODE_ENV=production
VUE_APP_ENVIRONMENT=development
