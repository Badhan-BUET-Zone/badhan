# NODE_ENV is the webpack build flavour; VUE_APP_ENVIRONMENT is which deployment
# this is. Here the two happen to coincide — see .env.local, where they do not.
VUE_APP_BADHAN_API_BASE_URL=https://badhan-buet-test.uc.r.appspot.com
VUE_APP_FRONTEND_BASE=https://badhan-buet-test-46eca.web.app
NODE_ENV=development
VUE_APP_ENVIRONMENT=development
