# NODE_ENV is the webpack build flavour; VUE_APP_ENVIRONMENT is which deployment
# this is. Here the two happen to coincide — see .env.local, where they do not.
VUE_APP_BADHAN_API_BASE_URL=https://badhan-buet.uc.r.appspot.com
VUE_APP_FRONTEND_BASE=https://badhan-buet.web.app
NODE_ENV=production
VUE_APP_ENVIRONMENT=production
