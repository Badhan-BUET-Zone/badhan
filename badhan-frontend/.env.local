# NODE_ENV is the webpack build flavour: `development` means unminified, with
# devtools. VUE_APP_ENVIRONMENT is which deployment this is. They are not the same
# thing, and this file is where they differ — a local stack builds in development
# mode while calling itself `local`. That difference is exactly what used to make
# the local environment invisible from inside the app.
VUE_APP_BADHAN_API_BASE_URL=http://localhost:3000
VUE_APP_FRONTEND_BASE=http://localhost:8080
NODE_ENV=development
VUE_APP_ENVIRONMENT=local
