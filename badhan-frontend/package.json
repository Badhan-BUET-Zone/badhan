    "papaparse": "^5.5.4",
    "pdfjs-dist": "^2.16.105",
    "qrcode": "^1.5.4",
    "register-service-worker": "^1.7.2",
    "roboto-fontface": "*",
    "stream": "^0.0.2",
    "svg2pdf.js": "^2.7.0",
    "vue": "^2.6.14",
    "vue-chartjs": "^5.3.0",
    "vue-clipboard2": "^0.3.3",
    "vue-fragment": "^1.6.0",
    "vue-markdown": "^2.2.4",
    "vue-router": "^3.5.1",
    "vuelidate": "^0.7.7",
    "vuetify": "^2.6.0",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
