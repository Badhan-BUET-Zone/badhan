    "@typescript-eslint/parser": "^5.4.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-pwa": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^1.1.3",
    "babel-runtime": "^6.26.0",
    "cross-env": "^7.0.3",
    "deepmerge": "^4.2.2",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "firebase-tools": "^14.22.0",
    "raw-loader": "^4.0.2",
    "sass": "^1.32.8",
    "sass-loader": "^12.6.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vue-cli-plugin-vuetify": "~2.5.8",
    "vue-template-compiler": "^2.6.14",
    "vuetify-loader": "^1.7.0"
  },
  "__comment_on_overrides": "@vue/cli-plugin-typescript 5.0.8 pins fork-ts-checker 6.5.2, which patches ts.performance.mark. That property is getter-only from TypeScript 5 on, so the checker throws on startup and the build stops reporting type errors while still exiting 0. v9 dropped the patch. Remove this override only if the build still fails on a deliberate type error afterwards",
  "overrides": {
    "fork-ts-checker-webpack-plugin": "^9.1.0"
  }
