{
  "name": "badhan-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "serve:local": "vue-cli-service serve --mode local",
    "__comment_on_serve_production": "not a deploy: it builds and serves dist over http-server on this machine. The only script in either app whose name is an environment but whose meaning is a local convenience",
    "serve:production": "npm run build && http-server dist",
    "__comment_on_build": "bare `build` is an alias, not a second copy of the command, so it cannot drift from build:production. It exists because `npm run build` is what a Vue CLI project is expected to answer to",
    "build": "npm run build:production",
    "build:production": "vue-cli-service build --mode production",
    "build:development": "vue-cli-service build --mode development",
    "build:local": "vue-cli-service build --mode local",
    "lint": "vue-cli-service lint"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false,
    "stream": false
  },
  "dependencies": {
    "@mdi/font": "5.9.55",
    "axios": "^1.2.1",
    "bootstrap": "^5.2.3",
    "bootstrap-vue": "^2.23.1",
    "chart.js": "^4.4.2",
    "core-js": "^3.8.3",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
