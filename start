import { runProcessesInParallel } from './badhan-backup/scripts/parallel.mjs';
import { killPorts } from './badhan-backup/scripts/port_cleanup.mjs';
import { cleanUp } from './badhan-backup/scripts/clean_all_dependencies.mjs';
import { ensureNpmInstall } from './badhan-backup/scripts/ensure_npm_install.mjs';
import { deployToGoogleCloud } from './badhan-backend/upload-gcloud.js';
import { deployToFirebase } from './badhan-frontend/upload-firebase.js';
import { runTestSuite as runBackendTestSuite } from './badhan-backend-test/start';
import { runTestSuite as runFrontendTestSuite } from './badhan-frontend-test/start';

// Ensure Node.js version is >= 22
const [nodeMajor] = process.versions.node.split('.').map(v => parseInt(v, 10));
if (!Number.isFinite(nodeMajor) || nodeMajor < 22) {
  console.error(`Node.js v22 or higher is required to run this script. Detected v${process.versions.node}. Please upgrade Node.js (e.g., "nvm use 22").`);
  process.exit(1);
}

const args = process.argv.slice(2);

const cleanUpRequired = args.includes('--clean')

const deployRequired = args.includes('--deploy')

const testRequired = args.includes('--test')

if(testRequired){
  console.log('🧪 Running all tests...');
  console.log('========================');
  
  try {
    // Run backend tests (no arguments to run all tests)
    console.log('🔧 Starting backend tests...');
    const backendTestResult = await runBackendTestSuite();
    
    // Run frontend tests (no arguments to run all tests)
    console.log('🌐 Starting frontend tests...');
    const frontendTestResult = await runFrontendTestSuite();
    
    // Report results
    console.log('\n📊 Test Results Summary:');
    console.log('========================');
    console.log(`Backend Tests: ${backendTestResult ? '✅ PASSED' : '❌ FAILED'}`);
    console.log(`Frontend Tests: ${frontendTestResult ? '✅ PASSED' : '❌ FAILED'}`);
    
    const allTestsPassed = backendTestResult && frontendTestResult;
    console.log(`\nOverall Result: ${allTestsPassed ? '✅ ALL TESTS PASSED' : '❌ SOME TESTS FAILED'}`);
    
    if(!allTestsPassed){
      process.exit(1);
    }

    if(deployRequired){
      deployToGoogleCloud();
      deployToFirebase();
    }
    process.exit(0);
  } catch (error) {
    console.error('❌ Error running tests:', error.message);
    process.exit(1);
  }
}
await killPorts([27017, 3000, 8080, 4000]);



if(cleanUpRequired) {
  await cleanUp([
    '../../badhan-backend/node_modules',
    '../../badhan-frontend/node_modules',
    '../../badhan-backend-test/node_modules',
    '../../badhan-frontend-test/node_modules',
    '../../badhan-backend/mongodb_local',
    '../../badhan-backend/dist',
    '../../badhan-frontend/dist',
    '../../badhan-backup/scripts/.npm_install_stamps'
  ]);
}

await ensureNpmInstall("./badhan-backend")
await ensureNpmInstall("./badhan-frontend")
await ensureNpmInstall("./badhan-backend-test")
await ensureNpmInstall("./badhan-frontend-test")
await ensureNpmInstall("./badhan-backup");


const jobs = [
  { workingDir: './badhan-backend', cmd: 'node scripts/start_db.mjs', label: 'database'},
  { workingDir: './badhan-frontend', cmd: 'node ../badhan-backup/scripts/wait_for_port.mjs 3000 && npm run serve:local', label: 'frontend'},
  { workingDir: './badhan-backend', cmd: 'node ../badhan-backup/scripts/wait_for_port.mjs 3000 && npx nodemon --watch dist --ext js,map --delay 200ms --exec "npm run internal-server"', label: 'backend internal'},
  { workingDir: './badhan-backend', cmd: 'node ../badhan-backup/scripts/wait_for_port.mjs 27017 && npx nodemon', label: 'backend'}
];

if(cleanUpRequired){
  jobs.splice(1, 0, { workingDir: './badhan-backend', cmd: 'node ../badhan-backup/scripts/wait_for_port.mjs 27017 && npm run reset_db:local && npm run populate_db:local', label: 'database reset'})
}

runProcessesInParallel(jobs).catch(err => {
  console.error('One or more processes failed:', err);
});


