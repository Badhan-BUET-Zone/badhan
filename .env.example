# Copy this file to .env (git-ignored) and fill it in. Docker Compose reads .env by itself.

# Badhan Agent's OpenAI key, for the local backend only. Leave it empty to run without the agent.
# Prefer a key from an OpenAI project with a low monthly spending limit.
# Blank it for the backend tests, which refuse to run with a key set:
#   OPENAI_API_KEY= docker compose up -d --force-recreate backend
OPENAI_API_KEY=
