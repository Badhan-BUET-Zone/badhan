#!/usr/bin/env node

const jest = require('jest');
const path = require('path');
const fs = require('fs');
const { execSync } = require('child_process');
const axios = require('axios');

// Configuration
const CONFIG = {
  testTimeout: 30000,
  logRoot: path.join(__dirname, 'logs'),
  successDir: path.join(__dirname, 'logs', 'success'),
  errorDir: path.join(__dirname, 'logs', 'error'),
  jestConfig: path.join(__dirname, 'jest.config.js'),
};

/**
 * Ensures directories exist and clears old logs
 */
function setupLogDirectories() {
  console.log(`[start] Setting up log directories: ${CONFIG.logRoot}`);

  // Create directories if they don't exist
  if (!fs.existsSync(CONFIG.logRoot)) {
    fs.mkdirSync(CONFIG.logRoot, { recursive: true });
  }
  if (!fs.existsSync(CONFIG.successDir)) {
    fs.mkdirSync(CONFIG.successDir, { recursive: true });
  }
  if (!fs.existsSync(CONFIG.errorDir)) {
    fs.mkdirSync(CONFIG.errorDir, { recursive: true });
  }

  // Clear old log files
  try {
    const successFiles = fs.readdirSync(CONFIG.successDir);
    successFiles.forEach((file) => {
      if (file.endsWith('.txt')) {
        fs.unlinkSync(path.join(CONFIG.successDir, file));
      }
    });
  } catch (err) {
    // Directory might be empty, ignore error
  }

  try {
    const errorFiles = fs.readdirSync(CONFIG.errorDir);
    errorFiles.forEach((file) => {
      if (file.endsWith('.txt')) {
        fs.unlinkSync(path.join(CONFIG.errorDir, file));
      }
    });
  } catch (err) {
    // Directory might be empty, ignore error
  }
}

/**
 * Runs Jest tests directly using Jest API
 * @param {Array} args - Command line arguments to pass to Jest
 * @returns {Promise<boolean>} - Returns true if all tests pass, false otherwise
 */
async function runTests(args = []) {
  console.log('[start] Starting test execution...');

  // Check if a specific test file was provided
  const specificTest = args.find(
    (arg) => fs.existsSync(arg) && (arg.endsWith('.test.js') || arg.endsWith('.spec.js'))
  );

  if (specificTest) {
    console.log(`[start] Running specific test: ${specificTest}`);
  } else {
    console.log('[start] Running all tests');
  }

  // Prepare Jest configuration
  const jestConfig = {
    // Pass explicit Jest config to avoid implicit resolution of multiple configs
    config: JSON.stringify(require(CONFIG.jestConfig)),
    testTimeout: CONFIG.testTimeout,
    noColor: true,
    runInBand: true,
    silent: true, // Ensure Jest output is suppressed
    // Parse command line arguments
    ...parseJestArgs(args),
  };

  try {
    // Run Jest directly
    const { results } = await jest.runCLI(jestConfig, [__dirname]);

    if (results.success) {
      console.log('[start] All tests completed successfully');
      return true;
    } else {
      console.error('[start] Tests failed');
      return false;
    }
  } catch (error) {
    console.error('[start] Jest execution failed:', error.message);
    return false;
  }
}

/**
 * Parse command line arguments for Jest
 * @param {Array} args - Raw command line arguments
 * @returns {Object} - Jest configuration object
 */
function parseJestArgs(args) {
  const config = {};

  for (let i = 0; i < args.length; i++) {
    const arg = args[i];

    // Check if it's an absolute path to a test file
    if (fs.existsSync(arg) && (arg.endsWith('.test.js') || arg.endsWith('.spec.js'))) {
      config.testPathPattern = arg;
      // Pass the file path as a positional arg so Jest selects only this test
      config._ = [arg];
      config.runTestsByPath = true;
      config.$0 = 'start';
      continue;
    }

    // Check if it's a relative path to a test file
    if (arg.includes('/') && (arg.endsWith('.test.js') || arg.endsWith('.spec.js'))) {
      const fullPath = path.resolve(__dirname, arg);
      if (fs.existsSync(fullPath)) {
        config.testPathPattern = fullPath;
        // Pass the resolved file path as a positional arg
        config._ = [fullPath];
        config.runTestsByPath = true;
        config.$0 = 'start';
        continue;
      }
    }

    switch (arg) {
      case '--watch':
        config.watch = true;
        break;
      case '--watchAll':
        config.watchAll = true;
        break;
      case '--no-reset':
        config.resetMocks = false;
        break;
      case '--no-purge':
        // Skip the DB purge hooks; the setup files read this via the environment
        // because CLI args are not forwarded to Jest workers.
        process.env.NO_PURGE = '1';
        break;
      case '--verbose':
        config.verbose = true;
        break;
      case '--silent':
        config.silent = true;
        break;
      case '--testNamePattern':
        if (i + 1 < args.length) {
          config.testNamePattern = args[i + 1];
          i++; // Skip next argument as it's the pattern
        }
        break;
      case '--testPathPattern':
        if (i + 1 < args.length) {
          config.testPathPattern = args[i + 1];
          i++; // Skip next argument as it's the pattern
        }
        break;
      case '--maxWorkers':
        if (i + 1 < args.length) {
          config.maxWorkers = parseInt(args[i + 1]);
          i++; // Skip next argument as it's the value
        }
        break;
      default:
        // Handle unknown arguments
        if (arg.startsWith('--')) {
          console.warn(`[start] Unknown Jest argument: ${arg}`);
        }
        break;
    }
  }

  return config;
}

/**
 * Runs ESLint to check code quality
 * @returns {boolean} - Returns true if linting passes, false otherwise
 */
function runLinter() {
  console.log('[start] Running ESLint...');

  try {
    execSync('npm run lint', {
      cwd: __dirname,
      stdio: 'inherit', // Show lint output in real-time
    });
    console.log('[start] ✓ Linting passed');
    return true;
  } catch (error) {
    console.error('[start] ✗ Linting failed - please fix the errors above');
    return false;
  }
}

/**
 * Resolves the backend base URL from environment or defaults
 * @returns {string} - The backend base URL
 */
function resolveBackendURL() {
  const envBase = process.env.API_BASE_URL && process.env.API_BASE_URL.trim();
  if (envBase) return envBase;

  // Docker environment check
  if (fs.existsSync('/.dockerenv')) {
    return 'http://host.docker.internal:3000';
  }

  return 'http://localhost:3000';
}

/**
 * Checks if the backend server is running
 * @returns {Promise<boolean>} - Returns true if backend is running, false otherwise
 */
async function checkBackendHealth() {
  const backendURL = resolveBackendURL();
  console.log(`[start] Checking backend health at ${backendURL}...`);

  try {
    await axios.get(`${backendURL}/`, { timeout: 5000 });
    console.log('[start] ✓ Backend is running');
    return true;
  } catch (error) {
    console.error('[start] ✗ Backend is not responding');
    console.error(`[start] Please start the backend server at ${backendURL}`);
    if (error.code === 'ECONNREFUSED') {
      console.error('[start] Connection refused - make sure the server is running');
    } else if (error.code === 'ETIMEDOUT') {
      console.error('[start] Connection timed out - server might be slow to respond');
    }
    return false;
  }
}

/**
 * Validates Jest configuration
 */
function validateJestConfig() {
  if (!fs.existsSync(CONFIG.jestConfig)) {
    throw new Error(`Jest config file not found: ${CONFIG.jestConfig}`);
  }

  try {
    const jestConfig = require(CONFIG.jestConfig);
    console.log('[start] Jest configuration validated');
    return jestConfig;
  } catch (err) {
    throw new Error(`Invalid Jest configuration: ${err.message}`);
  }
}

/**
 * Main execution function that can be called programmatically
 * @param {Array} args - Optional command line arguments
 * @returns {Promise<boolean>} - Returns true if all tests pass, false otherwise
 */
async function runTestSuite(args = []) {
  try {
    console.log('[start] Badhan Backend Test Runner');
    console.log('[start] ===========================');

    // Run linter first
    const lintPassed = runLinter();
    if (!lintPassed) {
      console.error('[start] Aborting tests due to linting errors');
      return false;
    }

    // Check if backend is running
    const backendHealthy = await checkBackendHealth();
    if (!backendHealthy) {
      console.error('[start] Aborting tests - backend server is not running');
      return false;
    }

    // Validate Jest configuration
    validateJestConfig();

    // Setup log directories
    setupLogDirectories();

    // Run tests
    const success = await runTests(args);

    console.log(`[start] Test execution completed with success: ${success}`);

    return success;
  } catch (error) {
    console.error('[start] Error:', error.message);
    return false;
  }
}

/**
 * Main execution function for standalone execution
 * @returns {Promise<boolean>} - Returns true if all tests pass, false otherwise
 */
async function runBackendTests() {
  // Parse command line arguments
  const args = process.argv.slice(2);

  const success = await runTestSuite(args);
  return success;
}

// Export functions for potential use as module
module.exports = {
  runTestSuite,
  runTests,
  runLinter,
  checkBackendHealth,
  resolveBackendURL,
  setupLogDirectories,
  validateJestConfig,
  CONFIG,
};

// Run main function if this file is executed directly
if (require.main === module) {
  runBackendTests()
    .then((success) => {
      process.exit(success ? 0 : 1);
    })
    .catch((error) => {
      console.error('[start] Unexpected error:', error);
      process.exit(1);
    });
}
