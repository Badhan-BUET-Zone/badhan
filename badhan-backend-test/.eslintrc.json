{
  "env": { "es2021": true, "node": true, "jest": true },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": { "ecmaVersion": 12, "sourceType": "script" },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "rules": {
        "no-unused-vars": ["off"]
      }
    }
  ],
  "ignorePatterns": ["logs/**", "node_modules/**"]
}
