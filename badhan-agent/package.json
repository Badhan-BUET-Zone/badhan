{
  "name": "badhan-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A one-page chat agent that drives the Badhan API through OpenAI tool calls.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8090 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 8090 --strictPort"
  },
  "engines": {
    "node": "22.x.x"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "idb-keyval": "^6.3.0",
    "marked": "^18.2.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  }
}
