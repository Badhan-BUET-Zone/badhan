#!/usr/bin/env bash
# Launch backend after Mongo is up.  Works on Linux, macOS, Windows (Git-Bash).

set -euo pipefail
source ../badhan-backup/scripts/enable_node.sh

# Block until MongoDB is accepting connections on 27017
node ../badhan-backup/scripts/wait_for_port.mjs 27017

# ‼️ `exec` REPLACES the current shell with the npm process.
#     The server now has the same PID as this script, so killing the
#     parent tree always kills the server too.
exec npm run serve:local
